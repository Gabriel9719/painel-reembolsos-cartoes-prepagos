            "name": "pa",
            "dataType": "string",
            "sourceColumn": "pa",
            "lineageTag": "53182c9b-7f94-4b64-8bd6-7f9a44cb6004",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "nome_pa",
            "dataType": "string",
            "sourceColumn": "nome_pa",
            "lineageTag": "380a8b56-26e4-4368-b24e-5fd8462f8b96",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dPA",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Lista  = List.Sort(List.Distinct(List.RemoveNulls(List.Combine({fReembolso[pa], fCompraCartao[pa], fCredito[pa], fPrestacao[pa]})))),",
                "    Tabela = Table.FromList(Lista, Splitter.SplitByNothing(), {\"pa\"}),",
                "    Tipo   = Table.TransformColumnTypes(Tabela, {{\"pa\", type text}}),",
                "    Nome   = Table.AddColumn(Tipo, \"nome_pa\", each \"PA \" & [pa], type text)",
                "in",
                "    Nome"
              ]
            }
          }
        ]
      },
