    "expressions": [
      {
        "name": "PastaProcessado",
        "kind": "m",
        "expression": "\"C:\\\\Projetos\\\\painel-reembolsos-cartoes-prepagos\\\\data\\\\processado\\\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "fxLerProcessado",
        "kind": "m",
        "expression": [
          "(nome as text) as table =>",
          "let",
          "    Origem   = Csv.Document(File.Contents(PastaProcessado & nome & \".csv\"), [Delimiter = \";\", Encoding = 65001]),",
          "    Promover = Table.PromoteHeaders(Origem, [PromoteAllScalars = true])",
          "in",
          "    Promover"
        ]
      }
    ],
