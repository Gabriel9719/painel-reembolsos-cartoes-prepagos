        "measures": [
          {
            "name": "Reembolsos (R$)",
            "expression": "SUM ( fReembolso[valor] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "29709ca7-49ac-458b-883e-4eab2a6ac8f9"
          },
          {
            "name": "Qtd Reembolsos",
            "expression": "COUNTROWS ( fReembolso )",
            "formatString": "#,0",
            "lineageTag": "58b8b8ba-233e-4252-bb50-c458305e4a6d"
          },
          {
            "name": "Reembolsos Veículo Alugado (R$)",
            "expression": "    CALCULATE ( [Reembolsos (R$)], fReembolso[veiculo_alugado] = TRUE () )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "046b6678-e575-4d28-ad6e-7d173706efc1"
          },
          {
            "name": "Km Rodados",
            "expression": "SUM ( fReembolso[km] )",
            "formatString": "#,0",
            "lineageTag": "2f309196-bd67-491c-9e8e-09c28b8c5b2e"
          },
          {
            "name": "Custo por Km (veículo alugado)",
            "expression": "    DIVIDE ( [Reembolsos Veículo Alugado (R$)], CALCULATE ( [Km Rodados], fReembolso[veiculo_alugado] = TRUE () ) )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "6c73f416-fd40-4cb0-b61e-6406e84acfd2"
          },
          {
            "name": "Alertas de Km",
            "expression": "CALCULATE ( [Qtd Reembolsos], fReembolso[alerta_km] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "9dc97ae5-d92b-4345-98fb-61c37f96c7d0"
          },
          {
            "name": "Diferença Km (R$)",
            "expression": "SUM ( fReembolso[divergencia_km] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "295902bd-9568-4368-9a30-cdde88e398a1"
          },
          {
            "name": "% Enviado Fora do Prazo",
            "expression": "    DIVIDE ( CALCULATE ( [Qtd Reembolsos], fReembolso[fora_do_prazo_envio] = TRUE () ), [Qtd Reembolsos] )",
            "formatString": "0.0%",
            "lineageTag": "dda41a07-ca88-4384-aeda-a8162456bbde"
          },
          {
            "name": "Prazo Médio até Pagamento (dias)",
            "expression": "AVERAGE ( fReembolso[dias_ate_pagamento] )",
            "lineageTag": "fa1e15ab-6dce-462b-b83d-97fbdbc7629c"
          },
          {
            "name": "Créditos nos Cartões (R$)",
            "expression": "SUM ( fCredito[credito_total] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "be8b5df0-1a2d-4fd9-855e-070ef8310bd4"
          },
          {
            "name": "Gasto nos Cartões (R$)",
            "expression": "SUM ( fCompraCartao[valor] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "8c1da692-4bb7-4580-a400-ae09518d8b67"
          },
          {
            "name": "% Utilização do Crédito",
            "expression": "DIVIDE ( [Gasto nos Cartões (R$)], [Créditos nos Cartões (R$)] )",
            "formatString": "0.0%",
            "lineageTag": "498f5459-6d39-4b8d-95aa-60dfc6f14c5f"
          },
          {
            "name": "Gasto Manutenção (R$)",
            "expression": "SUM ( fUsoManutencao[gasto_manutencao] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "da84054e-9aa9-447c-ad2a-95b8fa3a45e7"
          },
          {
            "name": "Excedente Manutenção (R$)",
            "expression": "SUM ( fUsoManutencao[excedente] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "d0eda98f-a3c0-483d-b725-60594611f0c0"
          },
          {
            "name": "PA-mês acima do limite",
            "expression": "CALCULATE ( COUNTROWS ( fUsoManutencao ), fUsoManutencao[estourou_limite] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "16860a10-e4cd-4415-8489-d39ef7de477b"
          },
          {
            "name": "Compras sem Comprovante",
            "expression": "CALCULATE ( COUNTROWS ( fCompraCartao ), fCompraCartao[comprovante] = \"Não\" )",
            "formatString": "#,0",
            "lineageTag": "0a24a19f-3846-45c6-8eb5-65812139f04f"
          },
          {
            "name": "Prestações com Atraso",
            "expression": [
              "    CALCULATE ( COUNTROWS ( fPrestacao ),",
              "        fPrestacao[status] IN { \"Enviada com atraso\", \"Pendente (atrasada)\" } )"
            ],
            "formatString": "#,0",
            "lineageTag": "6f8a9578-64de-4366-918e-b9bb1f40c10c"
          },
          {
            "name": "% Prestações no Prazo",
            "expression": [
              "    DIVIDE ( CALCULATE ( COUNTROWS ( fPrestacao ), fPrestacao[status] = \"No prazo\" ),",
              "             CALCULATE ( COUNTROWS ( fPrestacao ), fPrestacao[status] <> \"Aguardando (no prazo)\" ) )"
            ],
            "formatString": "0.0%",
            "lineageTag": "ef7d28c0-ea25-4630-817b-43890225332a"
          },
          {
            "name": "Atraso Médio (dias)",
            "expression": "    AVERAGEX ( FILTER ( fPrestacao, fPrestacao[dias_atraso] > 0 ), fPrestacao[dias_atraso] )",
            "lineageTag": "b8346e48-2d44-4521-b5c2-e959ebe1c066"
          },
          {
            "name": "Baixado no Sistema (R$)",
            "expression": "SUM ( fCompraCartao[valor_baixado] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "91564630-e25f-47d0-a9a8-d634241198d6"
          },
          {
            "name": "Falta Baixar (R$)",
            "expression": "[Gasto nos Cartões (R$)] - [Baixado no Sistema (R$)]",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "5262238c-1975-4cb2-9e5a-b743eb7bca37"
          },
          {
            "name": "% Baixado",
            "expression": "DIVIDE ( [Baixado no Sistema (R$)], [Gasto nos Cartões (R$)] )",
            "formatString": "0.0%",
            "lineageTag": "05b70ded-7e4e-4350-9c91-04402a064c72"
          },
          {
            "name": "Créditos à Plataforma (R$)",
            "expression": "SUM ( fFundoFixo[creditos] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "1c63f153-8ad1-4280-a286-3a84565b8da4"
          },
          {
            "name": "Devoluções (R$)",
            "expression": "SUM ( fFundoFixo[devolucoes] )",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "fa8a142f-9c4c-43aa-bb59-ddf60fa8a957"
          },
          {
            "name": "Saldo Fundo Fixo (R$)",
            "expression": "[Créditos à Plataforma (R$)] - [Devoluções (R$)] - [Baixado no Sistema (R$)]",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "b438f7cb-c09f-42b0-9410-2d5792dd8a06"
          },
          {
            "name": "Saldo Fundo Fixo Acumulado (R$)",
            "expression": [
              "    VAR _ultima = MAX ( dCompetencia[competencia] )",
              "    RETURN",
              "        CALCULATE (",
              "            SUM ( fFundoFixo[saldo_fundo_fixo] ),",
              "            REMOVEFILTERS ( dCompetencia ),",
              "            dCompetencia[competencia] <= _ultima",
              "        )"
            ],
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "57f051bf-8ab7-4e40-9858-97c285ac3b55"
          }
        ]
      }
    ],
